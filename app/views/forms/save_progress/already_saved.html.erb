<% set_page_title(form_title(form_name: @current_context.form.name, page_name: t('.title'), mode: @mode, error: @already_saved_input.errors.any?)) %>

<% content_for :back_link do %>
    <%= link_to t("forms.back"), form_step_path(@form.id, @form.form_slug, @current_context.next_step_slug), class: "govuk-back-link" %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with(model: @already_saved_input, url: overwrite_saved_progress_path(@form.id, @form.form_slug), method: :post) do |f| %>
      <% if @already_saved_input.errors.any? %>
        <%= f.govuk_error_summary(t("error_summary_title")) %>
      <% end %>

      <h1 class="govuk-heading-l"><%= t('.title') %></h1>
      <%= t('.body_html', date: @last_saved_date, time: @last_saved_time) %>
      <%= f.govuk_radio_buttons_fieldset :already_saved, legend: { text: t('.legend'), tag: 'h2', size: 'm' } do %>
        <%= f.govuk_radio_button :already_saved, "overwrite", label: { text: t('.overwrite') } %>
        <%= f.govuk_radio_button :already_saved, "keep_saved", label: { text: t('.keep_saved') } %>
      <% end %>

      <%= f.govuk_submit t("continue") %>
    <% end %>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">
    <%= render SupportDetailsComponent::View.new(@current_context.support_details) %>
  </div>
</div>