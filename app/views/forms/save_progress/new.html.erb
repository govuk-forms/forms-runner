<% title = @sign_in_again ? t('.sign_in_again_title') : t('.title') %>
<% set_page_title(form_title(form_name: @current_context.form.name, page_name: title, mode: @mode)) %>

<% content_for :back_link do %>
    <%= link_to t("forms.back"), @back_link, class: "govuk-back-link" %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l"><%= title %></h1>

    <%= t('.body_html') %>

    <%= govuk_button_to(
          t('.continue_to_one_login_button'),
          "/auth/govuk_one_login",
          method: :post,
        ) %>
  </div>
</div>
