<% set_page_title(form_title(form_name: @current_context.form.name, page_name: t('.title'), mode: @mode)) %>

<% content_for :back_link do %>
    <%= link_to t("forms.back"), form_step_path(@form.id, @form.form_slug, @current_context.next_step_slug), class: "govuk-back-link" %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l"><%= t('.title') %></h1>

    <% if @one_login_email.present? %>
      <%= t('.signed_in_body_html', email: @one_login_email) %>

      <%= govuk_button_to(
            t("continue"),
            save_progress_path(@form.id, @form.form_slug),
            method: :post,
            form: { data: { turbo: false } },
          ) %>

      <p class="govuk-body">
        <%= link_to t('.sign_in_different_link'), "#" %>
      </p>
    <% else %>
      <%= t('.body_html') %>

      <%= govuk_button_to(
            t('.continue_to_one_login_button'),
            "/auth/govuk_one_login",
            method: :post,
            form: { data: { turbo: false } },
          ) %>
    <% end %>
  </div>
</div>
