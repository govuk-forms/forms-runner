<% set_page_title(form_title(form_name: @current_context.form.name, page_name: t('.title'), mode: @mode)) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= govuk_notification_banner(success: true) do |banner| %>
      <% banner.with_heading(text: t('.title')) %>
    <% end %>

      <%= t('.body_html', email: @one_login_email, deletion_date: @deletion_date, form_url: continue_saved_form_url(@current_context.form.id, @current_context.form.form_slug)) %>

      <% continue_path = if @current_context.next_step_slug == CheckYourAnswersStep::CHECK_YOUR_ANSWERS_STEP_SLUG && @current_context.form.copy_of_answers_enabled?
                           copy_of_answers_path(form_id: @current_context.form.id, form_slug: @current_context.form.form_slug)
                         else
                           form_step_path(@current_context.form.id, @current_context.form.form_slug, @current_context.next_step_slug)
                         end %>
      <%= govuk_button_link_to t('.continue_button'), continue_path %>

      <p class="govuk-body"><%= link_to t('.sign_out_link'), "#" %></p>
  </div>
</div>
