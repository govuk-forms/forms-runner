<% set_page_title(form_title(form_name: @current_context.form.name, page_name: t('.title'), mode: @mode)) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l"><%= t('.title') %></h1>

    <%= t('.body_html', email: @one_login_email, deletion_date: @deletion_date, form_url: form_url(@current_context.form.id, @current_context.form.form_slug)) %>

    <% if @auth_service.logged_in? %>
      <%= govuk_button_to(t('sign_out_of_govuk_one_login'), omniauth_logout_path, secondary: true) %>
    <% end %>
  </div>
</div>
