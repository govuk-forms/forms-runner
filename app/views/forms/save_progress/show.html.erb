<% set_page_title(form_title(form_name: @current_context.form.name, page_name: t('.title'), mode: @mode)) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l"><%= t('.title') %></h1>

    <%= t('.body_html', email: @one_login_email, deletion_date: @deletion_date) %>

    <%= govuk_button_link_to t('.continue_button'), @continue_path %>

    <% if @auth_service.logged_in? %>
      <%= govuk_button_to(t('sign_out_of_govuk_one_login'), sign_out_path(form_id: @current_context.form.id, form_slug: @current_context.form.form_slug), secondary: true) %>
    <% end %>
  </div>
</div>
