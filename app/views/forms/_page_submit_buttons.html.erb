<% if @current_context.form.save_and_return_enabled? %>
  <div class="govuk-button-group">
    <%= form_builder.govuk_submit(t("continue")) %>
    <%= form_builder.govuk_submit t("save_progress.save_and_exit"), secondary: true, name: "save_and_exit", value: "true" %>
  </div>
<% else %>
  <%= form_builder.govuk_submit(t("continue")) %>
<% end %>
